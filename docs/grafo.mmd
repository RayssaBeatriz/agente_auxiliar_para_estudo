---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	start_turn(start_turn)
	agent(agent)
	tools(tools)
	rewrite(rewrite)
	__end__([<p>__end__</p>]):::last
	__start__ --> start_turn;
	agent -.-> __end__;
	agent -.-> tools;
	rewrite --> agent;
	start_turn --> agent;
	tools -.-> agent;
	tools -.-> rewrite;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
